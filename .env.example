SENTINEL_APP_NAME=Sentinel
SENTINEL_ENVIRONMENT=development
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@localhost:5432/sentinel
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_LOG_LEVEL=INFO
SENTINEL_ADMIN_API_KEY=replace-this-with-a-long-random-development-secret
# false = fail closed with HTTP 503 when Redis rate-limit execution is unavailable
SENTINEL_RATE_LIMIT_FAIL_OPEN=false

# Container worker count. Keep at 1 for the included process-local metrics dashboard.
SENTINEL_UVICORN_WORKERS=1
# Optional local Grafana password override (change before exposing monitoring).
GRAFANA_ADMIN_PASSWORD=sentinel-local-only
